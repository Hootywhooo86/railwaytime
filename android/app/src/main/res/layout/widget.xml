<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- Header: label + duty switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rail_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:maxLines="1"
            android:text="RAILTIME"
            android:textColor="@color/teal"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/duty_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/duty_off"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="OFF DUTY"
            android:textColor="@color/ink"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Clocks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/rail_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="@color/orange"
            android:textSize="46sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/local_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:text="LOCAL"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <TextClock
                android:id="@+id/local_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/ink"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/on_duty_note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="On duty\nBoard paused · not refreshing"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/board_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView style="@style/WidgetDivider" />

        <!-- Position / ahead / before you -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout style="@style/WidgetTile" android:layout_weight="0.8">
                <TextView style="@style/WidgetLabel" android:text="POS" />
                <TextView android:id="@+id/v_position" style="@style/WidgetValue" />
                <TextView style="@style/WidgetSub" android:text=" " />
            </LinearLayout>

            <LinearLayout style="@style/WidgetTile" android:layout_weight="1.25">
                <TextView style="@style/WidgetLabel" android:text="AHEAD" />
                <TextView android:id="@+id/v_ahead" style="@style/WidgetValue" />
                <TextView android:id="@+id/v_ahead_sub" style="@style/WidgetSub" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetTile" android:layout_weight="0.95">
                <TextView style="@style/WidgetLabel" android:text="BEFORE YOU" />
                <TextView android:id="@+id/v_before" style="@style/WidgetValue" />
                <TextView style="@style/WidgetSub" android:text="called first" />
            </LinearLayout>
        </LinearLayout>

        <ImageView style="@style/WidgetDivider" />

        <!-- Your rest / next off rest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout style="@style/WidgetTile">
                <TextView style="@style/WidgetLabel" android:text="YOUR REST" />
                <TextView android:id="@+id/v_rest" style="@style/WidgetValueSmall" />
                <TextView android:id="@+id/v_rest_sub" style="@style/WidgetSub" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetTile">
                <TextView style="@style/WidgetLabel" android:text="NEXT OFF REST" />
                <TextView android:id="@+id/v_next" style="@style/WidgetValueSmall" />
                <TextView android:id="@+id/v_next_sub" style="@style/WidgetSub" />
            </LinearLayout>
        </LinearLayout>

        <ImageView style="@style/WidgetDivider" />

        <!-- Likely train -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView style="@style/WidgetLabel" android:text="LIKELY TRAIN" />
            <TextView
                android:id="@+id/v_train"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/orange"
                android:textSize="20sp" />
            <TextView android:id="@+id/v_train_sub" style="@style/WidgetSub" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/line_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="10sp" />
</LinearLayout>
