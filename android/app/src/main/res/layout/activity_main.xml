<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/Heading" android:layout_marginTop="4dp" android:text="RAILTIME" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/rail_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textColor="@color/orange"
                android:textSize="48sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <TextClock
                    android:id="@+id/local_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/rail_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_duty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/duty_off"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nap"
            style="@style/PixelButtonWide"
            android:layout_marginTop="12dp"
            android:background="@drawable/pixel_button"
            android:textColor="@color/bg"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/on_duty_note"
            style="@style/Card"
            android:layout_marginTop="14dp"
            android:text="You're on duty. Board info is hidden and nothing is fetched from CN until you switch to off duty."
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/board_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView style="@style/Heading" android:text="BOARD" />
            <TextView android:id="@+id/summary" style="@style/Card" />

            <TextView style="@style/Heading" android:text="YOUR LIKELY TRAIN (ESTIMATE)" />
            <TextView
                android:id="@+id/train"
                style="@style/Card"
                android:textColor="@color/orange"
                android:textStyle="bold" />

            <TextView style="@style/Heading" android:text="TRAIN ORDER" />
            <TextView android:id="@+id/order" style="@style/Mono" />

            <TextView style="@style/Heading" android:text="AHEAD OF YOU" />
            <TextView android:id="@+id/board" style="@style/Mono" />

            <TextView style="@style/Heading" android:text="CATS" />
            <TextView android:id="@+id/cats" style="@style/Card" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Allow refreshing in the background"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh now" />

        <Button
            android:id="@+id/btn_signin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in / refresh from IVRM" />

        <Button
            android:id="@+id/btn_chrome_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update from Chrome" />

        <Button
            android:id="@+id/btn_screenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import IVRM screenshot" />

        <Button
            android:id="@+id/btn_paste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste copied IVRM page" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="If sign-in won't load: open IVRM in Chrome, screenshot it, and Share → Railway Time board. Or Select all → Copy in Chrome and tap Paste."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings" />

        <Button
            android:id="@+id/btn_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share debug info" />
    </LinearLayout>
</ScrollView>
